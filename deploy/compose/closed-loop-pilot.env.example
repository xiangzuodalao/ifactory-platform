# Copy to .runtime/closed-loop/closed-loop-pilot.env, set mode 0600, and never commit values.
PILOT_RUNTIME_DIR=/absolute/path/to/ifactory-platform/.runtime
PILOT_STATE_DIR=/absolute/path/to/ifactory-platform/.runtime/closed-loop/state
PILOT_STATE_LOCK_FILE=/absolute/path/to/ifactory-platform/.runtime/closed-loop/.state.lock
PILOT_HOST_UID=1000
PILOT_HOST_GID=1000

CMMS_POSTGRES_DB=ifactory_cmms_pilot
CMMS_POSTGRES_USER=ifactory_cmms_pilot
CMMS_POSTGRES_PASSWORD_FILE=/absolute/path/to/.runtime/secrets/cmms-postgres-password
CMMS_JWT_SECRET_FILE=/absolute/path/to/.runtime/secrets/cmms-jwt-secret
CMMS_ADMIN_PASSWORD_FILE=/absolute/path/to/.runtime/secrets/cmms-admin-password
CMMS_PILOT_ADMIN_EMAIL=
CMMS_MINIO_BUCKET=ifactory-pilot
MINIO_ROOT_USER_FILE=/absolute/path/to/.runtime/secrets/minio-root-user
MINIO_ROOT_PASSWORD_FILE=/absolute/path/to/.runtime/secrets/minio-root-password

INTEGRATION_POSTGRES_DB=ifactory_integration
INTEGRATION_POSTGRES_USER=ifactory_integration
INTEGRATION_POSTGRES_PASSWORD=
PLATFORM_INTEGRATION_TENANT_ALIAS=ifactory-pilot
PLATFORM_INTEGRATION_TENANT_ID=00000000-0000-4000-8000-000000000001
PILOT_PDM_CREDENTIAL=
PILOT_TB_CREDENTIAL=
VALEO_PDM_PREDICTION_V2_BEARER_TOKEN=
